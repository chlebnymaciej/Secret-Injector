<?xml version="1.0" encoding="utf-8"?>
<!--
  Produces a Windows installer (ClickOnce "setup.exe") for Vault Injector - no Visual Studio required,
  just `dotnet publish` (see README "Building an installer"). Self-contained, so the target machine needs
  no separate .NET install.

  To publish:
    dotnet publish src\VaultInjector.App\VaultInjector.App.csproj -p:PublishProfile=ClickOnceProfile -c Release

  The installer (setup.exe + supporting files) lands in the PublishDir below. Run setup.exe on the target
  machine to install; it adds a Start Menu entry and an "Apps & Features" uninstall entry.

  Notes:
  - SignManifests is false, so Windows will show an "Unknown Publisher" warning on first install. To remove
    that, get a code-signing certificate, set ManifestCertificateThumbprint (or ManifestKeyFile) below, and
    flip SignManifests to true.
  - UpdateEnabled is false (no update feed) since this is meant for direct/manual distribution, not a
    hosted auto-update server. Bump ApplicationVersion (and ApplicationRevision back to 0) each release so
    a reinstall over an existing one is recognized as an upgrade rather than a downgrade.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <PublishDir>bin\Release\net8.0-windows\win-x64\app.publish\</PublishDir>
    <PublishUrl>bin\Release\net8.0-windows\win-x64\app.publish\</PublishUrl>
    <InstallUrl>bin\Release\net8.0-windows\win-x64\app.publish\</InstallUrl>
    <Install>true</Install>
    <UpdateEnabled>false</UpdateEnabled>
    <MapFileExtensions>false</MapFileExtensions>

    <ProductName>Vault Injector</ProductName>
    <PublisherName>Vault Injector</PublisherName>
    <SuiteName>Vault Injector</SuiteName>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>

    <ApplicationVersion>1.0.0.0</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <GenerateManifests>true</GenerateManifests>
    <SignManifests>false</SignManifests>
  </PropertyGroup>
</Project>
