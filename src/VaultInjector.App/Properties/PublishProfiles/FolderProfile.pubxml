<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain (non-ClickOnce) self-contained, single-file publish - the input for the Inno Setup installer
  script at installer/VaultInjector.iss (see README "Building a single setup.exe"). Unlike the ClickOnce
  profiles, this one needs no full-framework MSBuild:

    dotnet publish src\VaultInjector.App\VaultInjector.App.csproj -p:PublishProfile=FolderProfile -c Release

  IncludeNativeLibrariesForSelfExtract folds WPF's native DLLs into the single exe too (extracted to a
  temp dir at first run) instead of leaving them as loose files next to it, so the publish output is (for
  all practical purposes) just VaultInjector.exe.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\Release\net8.0-windows\win-x64\publish\</PublishDir>
  </PropertyGroup>
</Project>
