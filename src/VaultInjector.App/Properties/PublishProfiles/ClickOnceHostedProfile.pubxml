<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes a self-contained ClickOnce build directly onto the org's static file server, so people can
  install (and later auto-update) straight from a URL instead of being handed a folder:
    https://cm-dev.adrentech.com/static/VaultInjector/VaultInjector.application

  PublishDir is the Samba share's UNC path (the same server backs both SMB and the /static/ HTTPS root -
  confirmed by browsing \\cm-dev.adrentech.com\static, which is the write target for the HTTPS path
  above). InstallUrl/UpdateUrl are the HTTPS URL end users and already-installed clients actually hit.

  To publish (see README "Building an installer" for the plain local-file profile and why this needs
  full-framework MSBuild, i.e. run this from a Developer PowerShell for VS 2022):
    dotnet restore src\VaultInjector.App\VaultInjector.App.csproj -r win-x64
    msbuild src\VaultInjector.App\VaultInjector.App.csproj `
      /t:Publish /p:PublishProfile=ClickOnceHostedProfile /p:Configuration=Release `
      /p:RuntimeIdentifier=win-x64 /p:SelfContained=true

  Requires write access to \\cm-dev.adrentech.com\static (verified working for create and overwrite;
  the account used here could NOT delete files on that share, so don't rely on stale files there ever
  being cleaned up automatically).

  Bump ApplicationVersion (reset ApplicationRevision to 0) before every publish - otherwise ClickOnce
  won't recognize it as a newer version and already-installed clients won't offer the update.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <PublishDir>\\cm-dev.adrentech.com\static\VaultInjector\</PublishDir>
    <PublishUrl>https://cm-dev.adrentech.com/static/VaultInjector/</PublishUrl>
    <InstallUrl>https://cm-dev.adrentech.com/static/VaultInjector/</InstallUrl>
    <Install>true</Install>
    <MapFileExtensions>false</MapFileExtensions>

    <!-- Check for a newer version in the background after each launch, not before - this is a tray app
         that often starts at Windows sign-in, and shouldn't make the user wait on a network check first. -->
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Background</UpdateMode>
    <UpdateUrl>https://cm-dev.adrentech.com/static/VaultInjector/</UpdateUrl>

    <ProductName>Vault Injector</ProductName>
    <PublisherName>Vault Injector</PublisherName>
    <SuiteName>Vault Injector</SuiteName>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>

    <ApplicationVersion>1.0.0.0</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <GenerateManifests>true</GenerateManifests>
    <SignManifests>false</SignManifests>
  </PropertyGroup>
</Project>
