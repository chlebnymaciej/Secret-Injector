<Window x:Class="VaultInjector.App.Views.SecretEntryEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secret Menu Entry"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <Label Content="Alias (text shown in the context menu)"/>
        <TextBox x:Name="AliasBox"/>

        <Label Content="Vault path (relative to the base path configured on the Vault Connection tab)" Margin="0,10,0,0"/>
        <TextBox x:Name="RelativePathBox"/>

        <Label Content="Paste mode" Margin="0,10,0,0"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="SingleFieldRadio" Content="A specific field" GroupName="Mode" IsChecked="True" Checked="ModeRadio_Checked"/>
            <RadioButton x:Name="WholeJsonRadio" Content="Whole secret as JSON" GroupName="Mode" Margin="20,0,0,0" Checked="ModeRadio_Checked"/>
        </StackPanel>

        <Label Content="Field name" Margin="0,10,0,0"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FieldNameCombo" Grid.Column="0" IsEditable="True"/>
            <Button x:Name="TestButton" Grid.Column="1" Content="Test / Load Fields" Margin="8,0,0,0" Click="TestButton_Click"/>
        </Grid>
        <TextBlock x:Name="TestResultText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="DimGray"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="8,0,0,0" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
