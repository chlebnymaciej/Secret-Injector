<Window x:Class="VaultInjector.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VaultInjector.App.Views"
        Title="Vault Injector - Settings"
        Height="600" Width="680"
        MinHeight="520" MinWidth="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="DarkSlateGray"/>
            <Button x:Name="SaveButton" Content="Save" Width="90" Margin="0,0,8,0" Click="SaveButton_Click"/>
            <Button x:Name="CloseButton" Content="Close" Width="90" Click="CloseButton_Click"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Vault Connection">
                <StackPanel Margin="12">
                    <Label Content="Vault address (e.g. https://vault.example.com:8200)"/>
                    <TextBox x:Name="VaultAddressBox"/>

                    <Label Content="Namespace (optional - Vault Enterprise only)" Margin="0,10,0,0"/>
                    <TextBox x:Name="NamespaceBox"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="KV secrets engine mount path (e.g. secret)"/>
                            <TextBox x:Name="MountPathBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="KV version"/>
                            <ComboBox x:Name="KvVersionCombo">
                                <ComboBoxItem Content="Version 2 (default)" Tag="V2"/>
                                <ComboBoxItem Content="Version 1" Tag="V1"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Label Content="Base path (prefix applied to every secret entry below, e.g. myapp/prod)" Margin="0,10,0,0"/>
                    <TextBox x:Name="BasePathBox"/>

                    <CheckBox x:Name="SkipTlsCheckBox" Content="Skip TLS certificate verification (trusted internal test environments only)" Margin="0,10,0,0"/>

                    <Separator Margin="0,16,0,10"/>

                    <TextBlock x:Name="LoginStatusText" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Label Content="Vault token (obtain it yourself, e.g. via 'vault login -method=oidc', then paste it here)"/>
                    <PasswordBox x:Name="TokenBox"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="LoginButton" Content="Log in" Width="110" Click="LoginButton_Click"/>
                        <Button x:Name="LogoutButton" Content="Log out" Width="110" Margin="8,0,0,0" Click="LogoutButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Secrets Menu">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="These entries appear, in order, in the context menu opened by the hotkey. Each entry can paste either one field of a secret or the whole secret as JSON."/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="AddSecretButton" Content="Add..." Width="90" Click="AddSecretButton_Click"/>
                        <Button x:Name="EditSecretButton" Content="Edit..." Width="90" Margin="8,0,0,0" Click="EditSecretButton_Click"/>
                        <Button x:Name="RemoveSecretButton" Content="Remove" Width="90" Margin="8,0,0,0" Click="RemoveSecretButton_Click"/>
                        <Button x:Name="PreviewKeysButton" Content="Preview Keys..." Width="110" Margin="8,0,0,0" Click="PreviewKeysButton_Click"/>
                        <Button x:Name="MoveUpButton" Content="Move Up" Width="90" Margin="24,0,0,0" Click="MoveUpButton_Click"/>
                        <Button x:Name="MoveDownButton" Content="Move Down" Width="90" Margin="8,0,0,0" Click="MoveDownButton_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="SecretsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Alias (menu text)" Binding="{Binding Alias}" Width="180"/>
                            <DataGridTextColumn Header="Vault path (relative to base path)" Binding="{Binding RelativePath}" Width="220"/>
                            <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="110"/>
                            <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Hotkey">
                <StackPanel Margin="12">
                    <Label Content="Global shortcut that opens the secrets context menu at the cursor:"/>
                    <local:HotkeyRecorderControl x:Name="HotkeyRecorder" Width="260" HorizontalAlignment="Left"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Foreground="DimGray"
                               Text="Click the box above and press the key combination you want, e.g. Ctrl+Alt+V. It works from any application, system-wide. If it stops working, another application may already be using the same combination."/>
                </StackPanel>
            </TabItem>

            <TabItem Header="General">
                <StackPanel Margin="12">
                    <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start Vault Injector when I sign in to Windows"/>

                    <CheckBox x:Name="RestoreClipboardCheckBox" Content="Restore previous clipboard contents after pasting a secret" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                        <Label Content="Restore delay (ms):" VerticalAlignment="Center"/>
                        <TextBox x:Name="ClipboardDelayBox" Width="80" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Separator Margin="0,16,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="Log level"/>
                            <ComboBox x:Name="LogLevelCombo">
                                <ComboBoxItem Content="Verbose"/>
                                <ComboBoxItem Content="Debug"/>
                                <ComboBoxItem Content="Information"/>
                                <ComboBoxItem Content="Warning"/>
                                <ComboBoxItem Content="Error"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Retained days"/>
                            <TextBox x:Name="LogRetainedDaysBox"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="OpenLogsButton" Content="Open Logs Folder" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenLogsButton_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
